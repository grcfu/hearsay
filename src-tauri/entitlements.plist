<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  The helper is a separate binary that Hearsay spawns. Without this, the hardened
	  runtime refuses to execute it and system audio capture fails at launch.
	-->
	<key>com.apple.security.cs.disable-library-validation</key>
	<true/>

	<!-- Microphone access, used only in conversation mode. -->
	<key>com.apple.security.device.audio-input</key>
	<true/>
</dict>
</plist>
