{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hearsay",
  "version": "0.1.0",
  "identifier": "com.hearsay.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "Hearsay",
        "width": 1200,
        "height": 780,
        "minWidth": 960,
        "minHeight": 600,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data:; media-src 'self' asset: http://asset.localhost blob:; connect-src 'self' ipc: http://ipc.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/hearsay/recordings/*"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ],
    "resources": {
      "../bin/hearsay-audio-helper": "hearsay-audio-helper",
      "../python/transcribe.py": "python/transcribe.py",
      "../python/requirements.txt": "python/requirements.txt"
    },
    "macOS": {
      "minimumSystemVersion": "14.4",
      "entitlements": "entitlements.plist"
    },
    "copyright": "",
    "category": "Productivity",
    "shortDescription": "Local-first meeting recorder",
    "longDescription": "Records meetings, transcribes them on-device, and stores them as searchable events. Nothing leaves the machine."
  }
}
